      <OtherUnitFiles Value="../../Sample/TCP_IP;../../Sample/DatenSteuerung;../units;../../Sample/Graphik"/>
      <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
    </SearchPaths>
    <Parsing>
      <SyntaxOptions>
